{
  "manifest_version": 3,
  "name": "Verso – YouTube Music Lyrics",
  "description": "Karaoke-style, time-synced lyrics in the YouTube Music lyrics tab.",
  "homepage_url": "https://github.com/gabrielsenadev/verso",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
