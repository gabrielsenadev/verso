{
  "manifest_version": 3,
  "name": "YouTube Music Synced Lyrics",
  "description": "Synced lyrics for YouTube Music",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "host_permissions": ["*://music.youtube.com/*"]
}
